# Supabase project credentials
# Find these in your Supabase dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Security note (web):
# On the web build, Supabase sessions are stored in localStorage (no httpOnly cookie
# alternative exists without a server). RLS policies are the primary security layer.
# Native iOS/Android builds use expo-secure-store instead.
