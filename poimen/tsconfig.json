{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  // supabase/functions is Deno, not React Native: different globals (Deno.serve,
  // Deno.env), different type roots, and it is typechecked by the Edge Runtime
  // at deploy rather than here. Including it makes `npm run typecheck` fail on
  // code that is correct for the runtime it actually runs on.
  "exclude": ["supabase/functions"],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}